# =============================================================================
# StewardAI environment variables
# =============================================================================
# Copy this file to `.env` in the repository root and fill in the values:
#
#     cp .env.example .env
#
# Both apps read that one file: the Python backend (apps/backend) and the Next.js
# frontend (apps/web, via next.config.ts). `.env` is git-ignored; never commit it.
# Variables already set in the process environment take precedence over the file, so
# on the live backend host and on Vercel set these in their secrets settings instead.
#
# Which app reads a variable:
#   [backend]  Python API + worker only. Secret: never exposed to the browser.
#   [web]      Next.js. Every NEXT_PUBLIC_* value is built into the JavaScript bundle
#              and is PUBLIC: never put a secret in a NEXT_PUBLIC_* variable.
#              Restart `npm run dev` (or rebuild) after changing one.
#
# Setup order: create the Supabase project and run the steps in README.md
# ("Setting up a Supabase project") first; several values below only exist after that.


# -----------------------------------------------------------------------------
# Supabase project
# -----------------------------------------------------------------------------

# [backend] + [web] Project URL, e.g. https://abcdefghijklmnop.supabase.co
# Where: Supabase dashboard -> your project -> Project Settings -> Data API
#        ("Project URL"), or the "Connect" button at the top of the project.
# The two variables hold the same value: the web app needs the NEXT_PUBLIC_ name.
# Local Supabase CLI stack (`npx supabase start`): http://127.0.0.1:54321
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=

# [web] Public client key. Safe in the browser: row-level security limits what it can
# read (owner-only, see supabase/migrations).
# Where: Project Settings -> API Keys.
#   - Newer projects: the "Publishable key" (starts with sb_publishable_).
#   - Legacy keys tab: the "anon" "public" key (a long JWT starting with eyJ).
# Set ONE of the two names below. Never use the secret / service_role key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# [backend] Postgres connection string for the least-privilege `app_backend` role.
# Never the `postgres` user and never the service_role key.
# How to get it:
#   1. After `npx supabase db push`, give the role a password in the SQL editor:
#        alter role app_backend with login password '<long random password>';
#      (generate one with e.g. `openssl rand -base64 32`; avoid @ : / in it, or
#       percent-encode them in the URL below)
#   2. Dashboard -> "Connect" -> Connection string.
#      - "Direct connection" (preferred for the always-on backend):
#          postgresql://app_backend:<password>@db.<project-ref>.supabase.co:5432/postgres
#        This host is IPv6-only unless the project has the IPv4 add-on.
#      - "Session pooler" (use from an IPv4-only machine; note the user format):
#          postgresql://app_backend.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#   Replace the user shown in the dashboard (postgres) with app_backend as above.
DATABASE_URL=

# [backend] The owner's Supabase Auth user id (a UUID). The API rejects every other user.
# Where: create the owner under Authentication -> Users -> "Add user", then copy
#        the "UID" column of that user. Use the same id for the
#        `insert into private.app_owner ...` step in README.md.
OWNER_USER_ID=

# [web] Optional extra guard: the owner's email. Any other signed-in email is signed
# out at once. (Sign-ups are disabled anyway; this is defence in depth.)
NEXT_PUBLIC_ALLOWED_EMAIL=

# [backend] Only for projects still signing tokens with the legacy shared secret (HS256).
# Where: Project Settings -> JWT Keys. If the project uses the new asymmetric signing keys
# (default for new projects), leave this EMPTY: the API fetches the public keys itself from
# <SUPABASE_URL>/auth/v1/.well-known/jwks.json.
SUPABASE_JWT_SECRET=

# [backend] Require an MFA-verified (TOTP, "aal2") session on every authenticated API call.
# Keep true. Only set false temporarily while debugging locally.
REQUIRE_MFA=true


# -----------------------------------------------------------------------------
# Trading212 (read-only)
# -----------------------------------------------------------------------------

# [backend] Which Trading212 environment the key belongs to: demo (practice account) or
# live (real money). Demo and live keys are different; start with demo.
T212_ENV=demo

# [backend] API key and secret.
# How to get them:
#   1. Log in to Trading212 (web or app) and switch to the account the key is for
#      (the Practice account for demo, your Invest/real account for live).
#   2. Settings -> API (Beta) -> Generate API key.
#   3. Permissions: enable ONLY read permissions (account data, portfolio, metadata,
#      history). Leave every order-placing / pie-editing (write/execute) permission OFF.
#      The code has no write path, and the key must not allow one either.
#   4. Optional, recommended for live once the backend has a static IP: restrict the key
#      to that IP address.
#   5. Copy both the key and the secret right away; the secret may not be shown again.
# Check with: cd apps/backend && uv run python -m steward.trading212
T212_API_KEY=
T212_API_SECRET=


# -----------------------------------------------------------------------------
# Backend <-> frontend wiring
# -----------------------------------------------------------------------------

# [web] Base URL of the Python API. Local: http://localhost:8000 (the default if unset).
# Production: the backend host's public HTTPS URL.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# [backend] Comma-separated browser origins allowed to call the API (CORS).
# Local: http://localhost:3000. Production: add the Vercel URL, e.g.
#   http://localhost:3000,https://stewardai.vercel.app
CORS_ORIGINS=http://localhost:3000

# [backend] DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO


# -----------------------------------------------------------------------------
# Development and tests only
# -----------------------------------------------------------------------------

# [backend tests] A Postgres SUPERUSER URL for the migration tests. They create and
# drop throwaway databases, so NEVER point this at the Supabase project. Use a local
# Postgres, e.g. postgresql://postgres:postgres@localhost:5432/postgres
# pytest reads it from the shell environment, not from this file:
#   STEWARD_TEST_DATABASE_URL=... uv run pytest
# STEWARD_TEST_DATABASE_URL=


# -----------------------------------------------------------------------------
# Later phases: not read by the code yet
# -----------------------------------------------------------------------------
# Listed so you can obtain the keys ahead of time. Uncomment when the phase lands.

# Phase 2+: Claude API (extraction, verdicts, news classification, digests, research).
# Where: https://console.anthropic.com -> API Keys -> Create key. Also set a monthly
# spend limit there (Settings -> Limits), as the spec's cost controls require.
# ANTHROPIC_API_KEY=

# Phase 2: Supabase Storage writes to the `evidence` bucket, server-side only.
# Where: Project Settings -> API Keys -> "Secret key" (sb_secret_...), or the legacy
# service_role key. Full access: backend only, never NEXT_PUBLIC_.
# SUPABASE_SECRET_KEY=

# Phase 2: SEC EDGAR requires a descriptive User-Agent with a contact email (no key).
# SEC_USER_AGENT="StewardAI personal use you@example.com"

# Phase 2-3: Finnhub free tier (US earnings calendar, company news).
# Where: sign up at https://finnhub.io -> Dashboard -> API key.
# FINNHUB_API_KEY=

# Phase 3: FRED macro series.
# Where: create an account at https://fredaccount.stlouisfed.org -> API Keys -> Request API Key.
# FRED_API_KEY=

# Phase 3: Telegram alerts.
# Bot token: message @BotFather on Telegram -> /newbot -> copy the token.
# Chat id: send your bot any message, then open
#   https://api.telegram.org/bot<token>/getUpdates  and copy "chat":{"id": ...}.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Phase 3: email alerts and digests via Resend.
# Where: https://resend.com -> API Keys -> Create API Key; verify a sending domain
# under Domains (or use their test sender while developing).
# RESEND_API_KEY=
# ALERT_EMAIL_FROM=
# ALERT_EMAIL_TO=
