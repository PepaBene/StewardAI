# Copy to .env (git-ignored). On the live host, set these through its secrets manager.

LOG_LEVEL=INFO

# Direct Postgres connection as the least-privilege app_backend role (never postgres).
# Supabase: Project Settings -> Database -> Connection string -> Direct connection,
# with the user replaced by app_backend. The direct host is IPv6-only unless the
# project has the IPv4 add-on; from an IPv4-only host use the session pooler instead
# (user app_backend.<project-ref>, port 5432).
DATABASE_URL=postgresql://app_backend:<password>@db.<project-ref>.supabase.co:5432/postgres

# Supabase Auth. The API fetches signing keys from <SUPABASE_URL>/auth/v1/.well-known/jwks.json.
SUPABASE_URL=https://<project-ref>.supabase.co
# Only for projects still on legacy HS256 signing (Settings -> JWT Keys). Leave empty otherwise.
SUPABASE_JWT_SECRET=
# The owner's auth user id (Authentication -> Users). Every other user is rejected.
OWNER_USER_ID=
# Require an MFA-verified session (aal2) on every authenticated API call.
REQUIRE_MFA=true

# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:3000

# Trading212: create the key with read scopes only. demo or live.
T212_ENV=demo
T212_API_KEY=
T212_API_SECRET=
