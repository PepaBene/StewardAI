    "structures": [
      {
        "name": "Productivity database",
        "names": {
          "en": "Productivity database"
        },
        "description": "The OECD Productivity Database is the successor to the previous edition, offering improved coverage and detail. It consolidates and replaces earlier datasets, including those on productivity levels, productivity growth rates, and productivity by industry. The goal is to provide users with the most comprehensive, up-to-date, and granular productivity estimates available. Data are released on a rolling basis: each variable is published as soon as its underlying source is updated. The database includes annual labour productivity data -measured using both employment and hours worked - as well as detailed components of labour and capital inputs. In addition, quarterly estimates are available in a separate database covering productivity and unit labour costs.",
        "descriptions": {
          "en": "The OECD Productivity Database is the successor to the previous edition, offering improved coverage and detail. It consolidates and replaces earlier datasets, including those on productivity levels, productivity growth rates, and productivity by industry. The goal is to provide users with the most comprehensive, up-to-date, and granular productivity estimates available. Data are released on a rolling basis: each variable is published as soon as its underlying source is updated. The database includes annual labour productivity data -measured using both employment and hours worked - as well as detailed components of labour and capital inputs. In addition, quarterly estimates are available in a separate database covering productivity and unit labour costs."
        },
