    "structures": [
      {
        "name": "Consumer price indices (CPIs, HICPs), COICOP 1999",
        "names": {
          "en": "Consumer price indices (CPIs, HICPs), COICOP 1999"
        },
        "description": "This dataset contains statistics on Consumer Price Indices by COICOP 1999 divisions, including national CPIs, Harmonised Indices of Consumer Prices (HICPs) and their associated weights and contributions to national year-on-year inflation. For countries for which data are already available according to the COICOP 2018 classification statistics on Consumer Price Indices can be found in dataset <a href=\"https://data-explorer.oecd.org/vis?lc=en&pg=0&fs%5b0%5d=Topic%2C1%7CEconomy%23ECO%23%7CPrices%23ECO_PRI%23&fc=Topic&bp=true&snb=31&df%5bds%5d=dsDisseminateFinalDMZ&df%5bid%5d=DSD_PRICES_COICOP2018%40DF_PRICES_C2018_ALL&df%5bag%5d=OECD.SDD.TPS&df%5bvs%5d=1.0&dq=.M.N.CPI.PA._T.N.GY&lom=LASTNPERIODS&lo=13&to%5bTIME_PERIOD%5d=false\">Consumer price indices (CPIs, HICPs), COICOP 2018.</a> <br/>The data series presented have been chosen as the most relevant prices statistics for which comparable data across countries is available. Data are available monthly for all the countries except for Australia and New Zealand (quarterly data).",
        "descriptions": {
          "en": "This dataset contains statistics on Consumer Price Indices by COICOP 1999 divisions, including national CPIs, Harmonised Indices of Consumer Prices (HICPs) and their associated weights and contributions to national year-on-year inflation. For countries for which data are already available according to the COICOP 2018 classification statistics on Consumer Price Indices can be found in dataset <a href=\"https://data-explorer.oecd.org/vis?lc=en&pg=0&fs%5b0%5d=Topic%2C1%7CEconomy%23ECO%23%7CPrices%23ECO_PRI%23&fc=Topic&bp=true&snb=31&df%5bds%5d=dsDisseminateFinalDMZ&df%5bid%5d=DSD_PRICES_COICOP2018%40DF_PRICES_C2018_ALL&df%5bag%5d=OECD.SDD.TPS&df%5bvs%5d=1.0&dq=.M.N.CPI.PA._T.N.GY&lom=LASTNPERIODS&lo=13&to%5bTIME_PERIOD%5d=false\">Consumer price indices (CPIs, HICPs), COICOP 2018.</a> <br/>The data series presented have been chosen as the most relevant prices statistics for which comparable data across countries is available. Data are available monthly for all the countries except for Australia and New Zealand (quarterly data)."
        },
